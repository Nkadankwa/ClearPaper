# Copy the JDBC session-pooler (5432) or direct connection from Supabase Connect.
# Keep the password separate from the URL. Require TLS for the hosted database.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_DB_URL=jdbc:postgresql://POOLER_HOST:5432/postgres?sslmode=require&currentSchema=clearpaper
SUPABASE_DB_USER=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# Local PostgreSQL development only; a real Supabase Auth project is still needed.
POSTGRES_DB=clearpaper
POSTGRES_USER=clearpaper
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
POSTGRES_PORT=5432
